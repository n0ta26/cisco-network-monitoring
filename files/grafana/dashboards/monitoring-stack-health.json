                "name": "panel-4"
              }
            }
          },
          {
            "kind": "GridLayoutItem",
            "spec": {
              "x": 8,
              "y": 16,
              "width": 8,
              "height": 8,
              "element": {
                "kind": "ElementReference",
                "name": "panel-5"
              }
            }
          },
          {
            "kind": "GridLayoutItem",
            "spec": {
              "x": 16,
